# Backend configuration.
#
#   cp .env.example .env
#
# These are exactly the variables this project uses. Values shown are the
# working defaults; the blank ones are credentials you must fill in.
# Never commit .env.

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (Neon). postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Redis (Upstash REST API, over HTTPS).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# Private Python RAG service. Express starts it on loopback.
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_SERVICE_HOST=127.0.0.1
RAG_SERVICE_PORT=8000
RAG_SERVICE_AUTOSTART=true
# Interpreter with backend/rag_service/requirements.txt installed.
# Docker: /opt/venv/bin/python
PYTHON_BIN=C:\Users\ahmed\.conda\envs\genai\python.exe
RAG_SERVICE_TOKEN=
RAG_SERVICE_STARTUP_TIMEOUT=180000

# --- Stream deadlines ----------------------------------------------------------
# The browser keeps the composer in its generating state, Stop button and all,
# until the chat stream closes - so every layer below has a deadline and none of
# them may wait forever.
#
# Longest gap allowed between frames from the RAG service. It heartbeats every
# few seconds while it works, so silence for this long means it is wedged rather
# than busy, and the turn is failed instead of waited out.
RAG_STREAM_IDLE_TIMEOUT=90000
# Hard ceiling on one chat turn, after which the response is closed with an
# error however stuck the pipeline is. A backstop, not a quality-of-service
# timeout: it has to outlast a rate-limited Mistral call retrying and then
# failing over to Hugging Face (see LLM_FALLBACK_* below).
CHAT_TURN_TIMEOUT=600000

# Language model.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2506
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000

# --- Fallback language model ---------------------------------------------------
# Mistral above stays the primary model and answers every request. When a call
# to it fails for a reason Mistral owns - connection error, timeout, rate limit,
# 5xx, rejected key - the same prompt is replayed once against Llama 3.1 8B on
# the Hugging Face Inference API, and the answer comes from there instead. A
# successful Mistral call is never rerouted.
#
# Set to false to turn the fallback off entirely; the service then behaves
# exactly as it did before the fallback existed.
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_FALLBACK_API_URL=https://router.huggingface.co/v1/chat/completions

# Credential for the fallback. Optional: it defaults to the Hugging Face token
# below, so a deployment that already has one needs no extra configuration.
# Leaving both blank simply disables the fallback (logged at startup).
HF_LLM_API_TOKEN=

# Seconds to wait for Hugging Face, and how many times to retry a rate limit or
# a model that is still loading before giving up.
LLM_FALLBACK_TIMEOUT=60
LLM_FALLBACK_MAX_RETRIES=2

# Seconds one generation may run before the RAG service closes its stream with a
# timeout, however stuck the model client is. Sized to outlast Mistral's own
# retries plus a full failover to Hugging Face, and still stream a long answer.
GENERATE_BUDGET_SECONDS=540

# --- Embeddings --------------------------------------------------------------
# api   -> hosted embedding endpoint. No model download, no torch at runtime.
# local -> sentence-transformers loaded in-process (needs the model below).
EMBEDDING_PROVIDER=api

# The hosted model. This is the SAME model as the local one, so vectors already
# in pgvector stay valid and nothing needs re-embedding.
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Must match the vector(N) column in migration 004. The service verifies the
# provider's real output against this at startup and refuses to run on a
# mismatch, rather than writing unusable vectors.
EMBEDDING_DIMENSION=768

# API credential. Your Hugging Face token (hf_...).
# EMBEDDING_API_KEY is optional and falls back to this value.
HUGGINGFACEHUB_API_TOKEN=
EMBEDDING_API_KEY=

# Only used when EMBEDDING_PROVIDER=local.
LOCAL_EMBEDDING_MODEL=C:\OpenSourcesModels\HuggingFace\Embeddings\hub\models--sentence-transformers--all-mpnet-base-v2\snapshots\e8c3b32edf5434bc2275fc9bab85f82640a19130
# cuda | cpu
EMBEDDING_DEVICE=cuda
# Legacy switch, ignored while EMBEDDING_PROVIDER is set.
USE_LOCAL_EMBEDDINGS=true

# Legacy Chroma CLI (python pipeline.py). The web app ignores these.
CHROMA_PERSIST_DIR=./chroma_persist
DOCUMENTS_DIR=./data/documents
MAX_RETRIEVAL_DISTANCE=1.5

# Chunking and retrieval.
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=12
# pgvector cosine distance, 0..2. Lower is stricter.
RETRIEVAL_MAX_DISTANCE=0.75

# Ingestion memory. Documents are extracted, embedded and inserted in batches,
# so peak memory is one batch rather than one document. Lower both on a small
# instance (512 MB); neither changes the chunks or vectors that get stored.
# Chunks per batch: embedded in one call and inserted in one transaction.
INGEST_BATCH_SIZE=64
# PDF pages read before the reader is reopened to release its object cache.
PDF_PAGE_WINDOW=50

# Live progress reporting during ingestion. Counters are real measurements; these
# only control how often they are refreshed.
# Minimum gap between progress writes to the documents table.
PROGRESS_INTERVAL_MS=700
# Report every Nth text page. OCR pages always report, being much slower.
PROGRESS_PAGE_INTERVAL=10

# Web search.
TAVILY_API_KEY=

# Conversation history sent to the model.
HISTORY_MESSAGE_LIMIT=6
HISTORY_CHAR_LIMIT=6000

# Sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=
SESSION_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Google OAuth. Leave blank to hide the "Continue with Google" button.
# The callback URL must match the one registered in Google Cloud Console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Document storage. local needs a mounted volume in production; use s3 for
# more than one instance.
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
UPLOAD_MAX_BYTES=26214400

# Rate limits.
RATE_LIMIT_LOGIN=5
RATE_LIMIT_SIGNUP=5
RATE_LIMIT_CHAT=20
RATE_LIMIT_UPLOAD=10

# --- Daily chat quota ----------------------------------------------------------
# A per-user allowance, not a burst limit: one Redis counter per user per
# calendar day (chat_limit:{userId}:{YYYY-MM-DD}), keyed by the authenticated
# session and never by IP. Requests rejected before the pipeline runs - an empty
# message, a document you do not own - are refunded, and one user request is one
# chat however the turn goes, including a Mistral failover to Hugging Face.
CHAT_DAILY_LIMIT=10
# The zone that decides when "tomorrow" starts. UTC keeps the reset identical
# everywhere the service runs; set an IANA zone (e.g. Asia/Kolkata) for local
# midnight instead.
CHAT_DAILY_LIMIT_TIMEZONE=UTC
# Matches REDIS_OPTIONAL: with Redis down, chats are served uncounted rather
# than refused. Set false to refuse them instead.
CHAT_DAILY_LIMIT_FAIL_OPEN=true

# Keep serving when Redis is unreachable (rate limiting and caching turn off).
REDIS_OPTIONAL=true

# LibreOffice, for legacy .doc / .ppt. LEAVE BLANK unless the binary is in an
# unusual place - it is auto-detected from PATH and the usual install
# locations, on Windows and Linux alike.
#
# Do NOT set a Windows path in a Linux/Docker deployment: C:... does not exist
# there. Detection warns and falls back to PATH, but the value is misleading.
#   Linux/Docker: /usr/bin/soffice   (auto-detected, no need to set)
#   Windows dev:  C:Program FilesLibreOfficeprogramsoffice.exe
LIBREOFFICE_PATH=
