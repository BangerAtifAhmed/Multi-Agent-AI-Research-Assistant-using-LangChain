# ---------------------------------------------------------------------------
# Backend configuration. Copy to backend/.env and fill in real values.
# Every secret lives here - the React frontend never sees any of them.
# Never commit backend/.env.
# ---------------------------------------------------------------------------

# --- Express server ---------------------------------------------------------
PORT=3000
NODE_ENV=development
# Where the React app runs. Used for OAuth redirects and CORS.
FRONTEND_URL=http://localhost:5173
# Extra allowed origins, comma separated (FRONTEND_URL is always allowed).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL (Neon) ------------------------------------------------------
# postgresql://user:password@host/db?sslmode=require
DATABASE_URL=
DATABASE_POOL_MAX=10

# --- Redis (Upstash) --------------------------------------------------------
# Preferred: the REST API over HTTPS (works where outbound 6379 is blocked).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative: a normal Redis connection. Upstash requires TLS, so use rediss://
REDIS_URL=
REDIS_KEY_PREFIX=ragchat
# true  -> the API keeps serving if Redis is down (rate limiting/caching off)
# false -> refuse to start without Redis
REDIS_OPTIONAL=true

# --- Sessions ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=rag_session
SESSION_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Defaults are correct for local dev. In production the cookie is automatically
# Secure + SameSite=None; override only if the frontend is same-site.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# --- Google OAuth 2.0 -------------------------------------------------------
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
#   Authorised JavaScript origin:  http://localhost:5173
#   Authorised redirect URI:       http://localhost:3000/api/auth/google/callback
# In production both must be HTTPS and match your real domains.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- LLM --------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2506
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000

# --- Embeddings -------------------------------------------------------------
# true  -> local sentence-transformers model (768-dim, matches the database)
# false -> Hugging Face inference endpoint
USE_LOCAL_EMBEDDINGS=true
LOCAL_EMBEDDING_MODEL=
EMBEDDING_DEVICE=cuda
HF_ENDPOINT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HUGGINGFACEHUB_API_TOKEN=
# Must match the vector(N) column in migration 004.
EMBEDDING_DIMENSION=768

# --- RAG service (private Python process, never exposed to the browser) ------
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_SERVICE_HOST=127.0.0.1
RAG_SERVICE_PORT=8000
RAG_SERVICE_AUTOSTART=true
# Interpreter that has the packages in backend/rag_service/requirements.txt
PYTHON_BIN=python
RAG_SERVICE_TOKEN=
RAG_SERVICE_STARTUP_TIMEOUT=180000

# --- Retrieval --------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=12
# pgvector cosine distance (0..2). Lower = stricter.
RETRIEVAL_MAX_DISTANCE=0.75
EMBED_BATCH_SIZE=64

# --- Web search tool --------------------------------------------------------
TAVILY_API_KEY=

# --- Document storage -------------------------------------------------------
# Original files are kept out of PostgreSQL. 'local' writes to STORAGE_DIR;
# swap in an S3/R2 driver for production.
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
UPLOAD_MAX_BYTES=26214400

# --- Chat history window sent to the LLM ------------------------------------
HISTORY_MESSAGE_LIMIT=6
HISTORY_CHAR_LIMIT=6000

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_LOGIN=5
RATE_LIMIT_SIGNUP=5
RATE_LIMIT_OAUTH=20
RATE_LIMIT_CHAT=20
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_API=300

# --- Cache TTLs (seconds) ---------------------------------------------------
CACHE_RETRIEVAL_TTL=300
CACHE_EMBEDDING_TTL=3600
CACHE_WEB_TTL=900

# --- Legacy (the original Chroma CLI in backend/rag_service) -----------------
# The web app uses PostgreSQL + pgvector; these only affect `python pipeline.py`.
CHROMA_PERSIST_DIR=./chroma_persist
DOCUMENTS_DIR=./data/documents
MAX_RETRIEVAL_DISTANCE=1.5

# --- Document ingestion system dependencies ---------------------------------
# Both are optional. Leave them empty to auto-detect from PATH and the usual
# install locations - which is what the Docker image relies on.
#
# IMPORTANT: on Windows write these paths UNQUOTED. dotenv processes escape
# sequences inside double-quoted values, so "C:\new\..." would break.
#
# LibreOffice: converts legacy .doc / .ppt to .docx / .pptx before extraction.
#   Windows: LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
#   Linux:   LIBREOFFICE_PATH=/usr/bin/soffice
#   Docker:  set in the image already
LIBREOFFICE_PATH=

# Tesseract: OCR for scanned PDFs.
#   Windows: TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
#   Linux:   TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_PATH=

# Legacy aliases, still honoured if the names above are unset.
SOFFICE_CMD=
TESSERACT_CMD=

# --- Embedding provider ------------------------------------------------------
# local -> sentence-transformers loaded in-process (development default)
# api   -> hosted embedding API (production: no model download, no torch)
EMBEDDING_PROVIDER=local

# Used when EMBEDDING_PROVIDER=api. Credentials come from the environment only.
#
# The default URL/model serve the SAME model as local development
# (sentence-transformers/all-mpnet-base-v2, 768-dim), so vectors already in
# pgvector stay valid and no re-embedding is needed.
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_API_BATCH_SIZE=32
EMBEDDING_API_TIMEOUT=60
