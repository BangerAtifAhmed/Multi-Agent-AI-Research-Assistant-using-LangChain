# Frontend configuration.
#
#   cp .env.example .env
#
# Anything in a VITE_ variable is compiled into the browser bundle and is
# readable by anyone. Never put a secret here - API keys, the database URL and
# the session secret all live in backend/.env only.

# Base URL of the Express API.
#
# Either spelling works; the client appends the server's /api mount point when
# it is missing:
#   https://your-backend.onrender.com        -> .../api/...
#   https://your-backend.onrender.com/api    -> .../api/...
#   /api                                     (frontend and API behind one domain)
#
# Local development: http://localhost:3000/api
VITE_API_URL=https://multi-agent-ai-research-assistant-using.onrender.com

# Vite reads this at BUILD time, not run time. On Vercel/Netlify/Render set it
# in the project's environment variables and redeploy - editing it afterwards
# has no effect until the next build.
#
# The backend must also allow this site's origin: set FRONTEND_URL on the
# server to wherever this app is hosted, or requests fail CORS.
